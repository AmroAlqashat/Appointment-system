{{#each businesses}}
    <a
      href="/business/details/{{id}}"
      class="group rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-soft hover:shadow-md hover:-translate-y-0.5 transition"
    >
      <div class="p-5">
        <p class="text-xs font-medium uppercase tracking-wider text-accent-600">
          {{category}}
        </p>
        <h3
          class="mt-1 font-semibold text-slate-900 group-hover:text-accent-700 transition"
        >
          {{name}}
        </h3>
        <p class="mt-1 text-sm text-slate-500 line-clamp-2">{{description}}</p>
        <div class="mt-4 flex items-center justify-between text-sm">
          <span class="flex items-center gap-1 text-slate-700">
            <span class="text-accent-500">★</span> {{rating}}
            <span class="text-slate-400">({{reviewCount}})</span>
          </span>
          <span class="text-slate-500">{{distanceInKM}} km away</span>
        </div>
      </div>
    </a>
{{/each}}
