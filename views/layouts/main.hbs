<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}} Slotly</title>
    <meta name="description" content="{{description}}" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script src="/js/htmx.min.js" defer></script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 font-sans antialiased">
    {{> header}}

    <main id="main" class="min-h-[calc(100vh-8rem)]">{{{body}}}</main>

    {{> footer}}

    <!-- HTMX target for toast/flash messages -->
    <div id="flash" class="fixed bottom-6 right-6 z-50 space-y-2"></div>
  </body>
</html>
