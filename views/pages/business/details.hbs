<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <a
    href="/businesses"
    class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-900"
    >← Back to browse</a
  >

  <!-- Header -->
  <div
    class="mt-4 rounded-2xl border border-slate-200 bg-white shadow-soft overflow-hidden"
  >
    <div
      class="h-40 sm:h-56 bg-gradient-to-br from-slate-800 via-slate-900 to-slate-800 relative"
    >
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(245,158,11,0.25),transparent_60%)]"
      ></div>
    </div>

    <div class="p-6 sm:p-8 -mt-12 relative">
      <div class="flex items-end justify-between flex-wrap gap-4">
        <div class="flex items-end gap-4">
          <div
            class="h-20 w-20 rounded-2xl bg-white border-4 border-white shadow-md flex items-center justify-center text-2xl font-bold text-slate-900"
          >
            {{business.initials}}
          </div>
          <div class="pb-1">
            <p
              class="text-xs font-medium uppercase tracking-wider text-accent-600"
            >
              {{business.category}}
            </p>
            <h1
              class="mt-1 text-2xl sm:text-3xl font-bold tracking-tight text-slate-900"
            >
              {{business.name}}
            </h1>
            <div class="mt-1 flex items-center gap-3 text-sm text-slate-600">
              <span class="flex items-center gap-1"
                ><span class="text-accent-500">★</span> {{business.rating}}
                ({{business.reviewCount}})</span
              >
              <span>·</span>
              <span>{{business.address}}</span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <span
            class="inline-flex items-center gap-1 rounded-full bg-emerald-50 text-emerald-700 px-3 py-1 text-xs font-medium"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Open ·
            closes {{business.closesAt}}
          </span>
        </div>
      </div>

      <p class="mt-6 text-sm text-slate-600 max-w-2xl leading-relaxed">
        {{business.description}}
      </p>
    </div>
  </div>

  <!-- Booking section -->
  <div class="mt-8 grid lg:grid-cols-3 gap-6">
    <!-- Date picker -->
    <div
      class="lg:col-span-1 rounded-2xl border border-slate-200 bg-white p-6 shadow-soft"
    >
      <h2 class="font-semibold text-slate-900">Pick a date</h2>
      <p class="mt-1 text-sm text-slate-500">
        Available slots will appear on the right.
      </p>

      <input
        type="date"
        name="date"
        min="{{today}}"
        value="{{today}}"
        hx-get="/businesses/{{business.id}}/slots"
        hx-trigger="change, load"
        hx-target="#slots"
        hx-swap="innerHTML"
        hx-indicator="#slots-spinner"
        class="mt-4 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 outline-none transition"
      />

      <div class="mt-6 space-y-3 text-sm">
        <div class="flex items-center justify-between text-slate-600">
          <span>Slot duration</span
          ><span class="font-medium text-slate-900"
            >{{business.slotDuration}} min</span
          >
        </div>
        <div class="flex items-center justify-between text-slate-600">
          <span>Working hours</span
          ><span class="font-medium text-slate-900"
            >{{business.opensAt}} – {{business.closesAt}}</span
          >
        </div>
      </div>
    </div>

    <!-- Slots -->
    <div
      class="lg:col-span-2 rounded-2xl border border-slate-200 bg-white p-6 shadow-soft"
    >
      <div class="flex items-center justify-between">
        <h2 class="font-semibold text-slate-900">Available time slots</h2>
        <span
          id="slots-spinner"
          class="htmx-indicator inline-flex items-center gap-2 text-xs text-slate-500"
        >
          <span
            class="h-3 w-3 rounded-full border-2 border-slate-300 border-t-slate-900 animate-spin"
          ></span>
          Loading…
        </span>
      </div>

      <div id="slots" class="mt-5">{{> slot-grid}}</div>
    </div>
  </div>
</section>
