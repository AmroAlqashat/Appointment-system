<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
    <div>
      <p class="text-sm text-slate-500">{{business.name}}</p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-900">Dashboard</h1>
    </div>
    <div class="flex gap-2">
      <button
        hx-get="/business/availability"
        hx-target="#main"
        hx-swap="innerHTML"
        class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-medium px-4 py-2.5 text-sm transition">
        ⚙ Manage availability
      </button>
      <a href="/business/services/new"
         class="inline-flex items-center gap-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-white font-medium px-4 py-2.5 text-sm transition">
        + New service
      </a>
    </div>
  </div>

  <!-- Stats -->
  <div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
    {{#each stats}}
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-soft">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-500">{{this.label}}</p>
        <p class="mt-2 text-2xl font-bold tracking-tight text-slate-900">{{this.value}}</p>
        <p class="mt-1 text-xs {{#if this.positive}}text-emerald-600{{else}}text-slate-500{{/if}}">{{this.delta}}</p>
      </div>
    {{/each}}
  </div>

  <div class="mt-8 grid lg:grid-cols-3 gap-6">
    <!-- Upcoming appointments -->
    <div class="lg:col-span-2 rounded-2xl border border-slate-200 bg-white shadow-soft overflow-hidden">
      <div class="px-6 py-5 border-b border-slate-200 flex items-center justify-between">
        <h2 class="font-semibold text-slate-900">Upcoming appointments</h2>
        <select name="range"
                hx-get="/business/appointments"
                hx-trigger="change"
                hx-target="#appt-list"
                hx-swap="innerHTML"
                class="text-xs rounded-lg border border-slate-300 px-2.5 py-1.5 bg-white focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 outline-none">
          <option value="today">Today</option>
          <option value="week" selected>This week</option>
          <option value="month">This month</option>
        </select>
      </div>

      <div id="appt-list" class="divide-y divide-slate-100">
        {{#each appointments}}
          <div class="px-6 py-4 flex items-center gap-4 hover:bg-slate-50 transition">
            <div class="flex-shrink-0 h-12 w-12 rounded-xl bg-accent-100 text-accent-700 flex flex-col items-center justify-center text-center">
              <span class="text-[10px] font-semibold uppercase">{{this.month}}</span>
              <span class="text-sm font-bold leading-none">{{this.day}}</span>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-medium text-slate-900 truncate">{{this.customer.name}}</p>
              <p class="text-sm text-slate-500">{{this.service}} · {{this.timeLabel}}</p>
            </div>
            <span class="hidden sm:inline-flex items-center gap-1 rounded-full bg-emerald-50 text-emerald-700 px-2.5 py-1 text-xs font-medium">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Confirmed
            </span>
            <div class="flex gap-1">
              <button
                hx-get="/business/appointments/{{this.id}}"
                hx-target="#main"
                hx-swap="innerHTML"
                class="text-xs px-2.5 py-1.5 rounded-md text-slate-600 hover:bg-slate-100">View</button>
              <button
                hx-delete="/business/appointments/{{this.id}}"
                hx-confirm="Cancel this appointment?"
                hx-target="closest div.px-6"
                hx-swap="outerHTML"
                class="text-xs px-2.5 py-1.5 rounded-md text-red-600 hover:bg-red-50">Cancel</button>
            </div>
          </div>
        {{/each}}
      </div>
    </div>

    <!-- Mini calendar -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-soft">
      <div class="flex items-center justify-between">
        <h2 class="font-semibold text-slate-900">{{calendar.monthLabel}}</h2>
        <div class="flex gap-1">
          <button
            hx-get="/business/calendar?month={{calendar.prev}}"
            hx-target="closest div.rounded-2xl"
            hx-swap="outerHTML"
            class="h-7 w-7 rounded-md hover:bg-slate-100 text-slate-600">‹</button>
          <button
            hx-get="/business/calendar?month={{calendar.next}}"
            hx-target="closest div.rounded-2xl"
            hx-swap="outerHTML"
            class="h-7 w-7 rounded-md hover:bg-slate-100 text-slate-600">›</button>
        </div>
      </div>

      <div class="mt-5 grid grid-cols-7 gap-1 text-center text-xs">
        {{#each calendar.weekdays}}
          <div class="text-slate-400 font-medium py-1">{{this}}</div>
        {{/each}}
        {{#each calendar.days}}
          <button
            hx-get="/business/appointments?date={{this.iso}}"
            hx-target="#appt-list"
            hx-swap="innerHTML"
            class="aspect-square rounded-md text-sm transition relative
                   {{#if this.outside}}text-slate-300{{else}}text-slate-700 hover:bg-slate-100{{/if}}
                   {{#if this.today}}bg-slate-900 text-white hover:bg-slate-800{{/if}}">
            {{this.day}}
            {{#if this.hasAppointments}}
              <span class="absolute bottom-1 left-1/2 -translate-x-1/2 h-1 w-1 rounded-full {{#if this.today}}bg-accent-400{{else}}bg-accent-500{{/if}}"></span>
            {{/if}}
          </button>
        {{/each}}
      </div>

      <div class="mt-6 pt-5 border-t border-slate-100">
        <h3 class="text-sm font-semibold text-slate-900">Today's availability</h3>
        <div class="mt-3 space-y-2 text-sm">
          <div class="flex items-center justify-between">
            <span class="text-slate-600">Booked</span>
            <span class="font-medium text-slate-900">{{availability.booked}} slots</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-slate-600">Available</span>
            <span class="font-medium text-emerald-600">{{availability.free}} slots</span>
          </div>
          <div class="h-2 rounded-full bg-slate-100 overflow-hidden">
            <div class="h-full bg-accent-500" style="width: {{availability.percent}}%"></div>
          </div>
        </div>

        <button
          hx-get="/business/availability"
          hx-target="#main"
          hx-swap="innerHTML"
          class="mt-5 w-full rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-medium py-2 text-sm transition">
          Edit working hours
        </button>
      </div>
    </div>
  </div>
</section>
