<section class="min-h-[calc(100vh-4rem)] flex items-center justify-center">
  <div class="mx-auto min-w-md">
    <div class="rounded-2xl border border-border bg-card p-8 shadow-sm">
      <h1 class="text-2xl font-semibold tracking-tight">Welcome back</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        Log in to manage your appointments.
      </p>

      <form id="login-form" hx-post="/login" hx-target="#login-form" hx-swap="outerHTML" class="mt-6 space-y-4">
        <label class="block">
          <span class="text-sm font-medium">Email</span>
          <input type="email" name="email" placeholder="you@example.com"
            class="mt-1.5 block w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40" />
        </label>

        <label class="block">
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium">Password</span>
            <a href="#" class="text-xs font-medium text-muted-foreground hover:text-foreground">Forgot?</a>
          </div>
          <input type="password" name="password" placeholder="••••••••"
            class="mt-1.5 block w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40" />
        </label>

        <button type="submit"
          class="w-full rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary/90 cursor-pointer">
          Log in
        </button>
      </form>

      <div class="mt-6 flex items-center gap-3 text-xs text-muted-foreground">
        <span class="h-px flex-1 bg-border"></span>OR<span class="h-px flex-1 bg-border"></span>
      </div>

      <button
        class="mt-4 w-full rounded-md border border-border bg-background px-4 py-2.5 text-sm font-medium hover:bg-secondary cursor-pointer">
        Continue with Google
      </button>

      <p class="mt-6 text-center text-sm text-muted-foreground">
        New to Slotly?
        <a href="/auth/signup/customer"
          class="font-medium text-foreground underline-offset-4 hover:underline cursor-pointer">Create an
          account</a>
      </p>
    </div>
  </div>

</section>