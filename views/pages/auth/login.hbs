<section
  class="min-h-[calc(100vh-4rem)] flex items-center justify-center p-6 sm:p-12 bg-slate-50"
>
  <div class="w-full max-w-md">
    <div class="bg-white rounded-2xl shadow-soft border border-slate-200 p-8">
      <div class="flex items-center justify-center mb-6">
        <img src="/calender_clock.png" alt="Logo" />
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 text-center">
        Welcome back
      </h1>
      <p class="mt-2 text-sm text-slate-600 text-center">
        Log in to manage your appointments.
      </p>

      <form
        hx-post="/login"
        hx-target="#login-error"
        hx-swap="innerHTML"
        class="mt-8 space-y-4"
      >
        <div>
          <label class="block text-sm font-medium text-slate-700">Email</label>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 outline-none transition"
          />
        </div>

        <div>
          <div class="flex items-center justify-between">
            <label class="block text-sm font-medium text-slate-700"
              >Password</label
            >
            <a
              href="/forgot-password"
              class="text-xs font-medium text-accent-600 hover:text-accent-700"
              >Forgot?</a
            >
          </div>
          <input
            type="password"
            name="password"
            required
            autocomplete="current-password"
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 outline-none transition"
          />
        </div>

        <label class="flex items-center gap-2 text-sm text-slate-600">
          <input
            type="checkbox"
            name="remember"
            class="rounded border-slate-300 text-accent-500 focus:ring-accent-500"
          />
          Remember me for 30 days
        </label>

        <div
          id="login-error"
          class="empty:hidden text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2"
        ></div>

        <button
          type="submit"
          class="w-full rounded-lg bg-slate-900 hover:bg-slate-800 text-white font-medium py-2.5 text-sm transition"
        >
          Log in
        </button>
      </form>
    </div>

    <p class="mt-6 text-sm text-slate-600 text-center">
      Don't have an account?
      <a
        href="/auth/signup"
        class="font-medium text-accent-600 hover:text-accent-700"
        >Sign up</a
      >
    </p>
  </div>
</section>
<div class="mx-auto max-w-md">
  <div class="rounded-2xl border border-border bg-card p-8 shadow-sm">
    <h1 class="text-2xl font-semibold tracking-tight">Welcome back</h1>
    <p class="mt-1 text-sm text-muted-foreground">
      Log in to manage your appointments.
    </p>

    <form
      id="login-form"
      hx-post="/login"
      hx-target="#login-form"
      hx-swap="outerHTML"
      class="mt-6 space-y-4"
    >
      <label class="block">
        <span class="text-sm font-medium">Email</span>
        <input
          type="email"
          name="email"
          placeholder="you@example.com"
          class="mt-1.5 block w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40"
        />
      </label>

      <label class="block">
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium">Password</span>
          <a
            href="#"
            class="text-xs font-medium text-muted-foreground hover:text-foreground"
            >Forgot?</a
          >
        </div>
        <input
          type="password"
          name="password"
          placeholder="••••••••"
          class="mt-1.5 block w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40"
        />
      </label>

      <button
        type="submit"
        class="w-full rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary/90"
      >
        Log in
      </button>
    </form>

    <div class="mt-6 flex items-center gap-3 text-xs text-muted-foreground">
      <span class="h-px flex-1 bg-border"></span>OR<span
        class="h-px flex-1 bg-border"
      ></span>
    </div>

    <button
      class="mt-4 w-full rounded-md border border-border bg-background px-4 py-2.5 text-sm font-medium hover:bg-secondary"
    >
      Continue with Google
    </button>

    <p class="mt-6 text-center text-sm text-muted-foreground">
      New to Slotly?
      <a
        href="/signup"
        class="font-medium text-foreground underline-offset-4 hover:underline"
        >Create an account</a
      >
    </p>
  </div>
</div>
