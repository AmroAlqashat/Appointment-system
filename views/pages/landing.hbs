<section
  class="relative overflow-hidden bg-gradient-to-b from-white to-slate-50"
>
  <div
    class="absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_top,black,transparent_70%)]"
  >
    <div
      class="absolute inset-x-0 top-0 h-[500px] bg-[radial-gradient(circle_at_50%_0%,rgba(245,158,11,0.12),transparent_60%)]"
    ></div>
  </div>

  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-24 sm:pt-28 sm:pb-32"
  >
    <div class="max-w-3xl mx-auto text-center">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-600 shadow-sm"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        Trusted by 2,400+ local businesses
      </span>

      <h1
        class="mt-6 text-4xl sm:text-6xl font-bold tracking-tight text-slate-900"
      >
        Booking appointments,
        <span class="text-accent-600">made effortless.</span>
      </h1>

      <p class="mt-6 text-lg text-slate-600 leading-relaxed">
        Slotly connects customers with the businesses they love. Schedule,
        reschedule, and manage appointments — all in one place.
      </p>

      <div class="mt-10 grid sm:grid-cols-2 gap-4 max-w-xl mx-auto">
        <a
          href="/auth/signup?type=business"
          class="group flex items-center justify-between rounded-xl border border-slate-200 bg-white p-5 text-left shadow-soft hover:border-emerald-500 hover:shadow-md transition"
        >
          <div>
            <p
              class="text-xs font-medium uppercase tracking-wider text-emerald-600"
            >
              For Owners
            </p>
            <p class="mt-1 font-semibold text-slate-900">
              I'm a Business Owner
            </p>
            <p class="mt-1 text-sm text-slate-500">
              Manage availablility & bookings
            </p>
          </div>
          <span
            class="ml-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500 text-white transition"
            >→</span
          >
        </a>
        <a
          href="/auth/signup?type=customer"
          class="group flex items-center justify-between rounded-xl border border-slate-200 bg-white p-5 text-left shadow-soft hover:border-emerald-500 hover:shadow-md transition"
        >
          <div>
            <p
              class="text-xs font-medium uppercase tracking-wider text-emerald-600"
            >
              For clients
            </p>
            <p class="mt-1 font-semibold text-slate-900">I'm a Customer</p>
            <p class="mt-1 text-sm text-slate-500">Book in seconds, anywhere</p>
          </div>
          <span
            class="ml-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500 text-white transition"
            >→</span
          >
        </a>
      </div>
    </div>

    <!-- Feature strip -->
    <div class="mt-24 grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <div
          class="h-10 w-10 rounded-lg bg-emerald-100 text-accent-700 flex items-center justify-center font-semibold"
        >
          ⚡
        </div>
        <h3 class="mt-4 font-semibold text-slate-900">Instant booking</h3>
        <p class="mt-1 text-sm text-slate-600">
          Real-time slot availability with zero double-bookings.
        </p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <div
          class="h-10 w-10 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-semibold"
        >
          📅
        </div>
        <h3 class="mt-4 font-semibold text-slate-900">Smart calendars</h3>
        <p class="mt-1 text-sm text-slate-600">
          Set working hours and slot duration once — we handle the rest.
        </p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <div
          class="h-10 w-10 rounded-lg bg-emerald-100 text-accent-400 flex items-center justify-center font-semibold"
        >
          🔔
        </div>
        <h3 class="mt-4 font-semibold text-slate-900">Reminders built-in</h3>
        <p class="mt-1 text-sm text-slate-600">
          Reduce no-shows with automated email & SMS notifications.
        </p>
      </div>
    </div>
  </div>
</section>
