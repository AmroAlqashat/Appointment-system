<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
    <div>
      <p class="text-sm text-slate-500">
        Welcome back, {{customer.firstName}} 👋
      </p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-900">
        Find a business
      </h1>
    </div>
  </div>

  <!-- Search + filters -->
  <div
    class="mt-8 rounded-2xl border border-slate-200 bg-white p-4 shadow-soft"
  >
    <form
      class="flex flex-col sm:flex-row gap-3"
      hx-get="/businesses/search"
      hx-trigger="input changed delay:300ms from:input[name='q'], change from:select[name='category'], submit"
      hx-target="#business-grid"
      hx-swap="innerHTML"
      hx-indicator="#search-spinner"
    >
      <div class="relative flex-1">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
          >🔍</span
        >
        <input
          type="text"
          name="q"
          placeholder="Search by business name…"
          class="w-full rounded-lg border border-slate-300 pl-10 pr-3 py-2.5 text-sm focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 outline-none transition"
        />
      </div>

      <select
        name="category"
        class="rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 outline-none transition"
      >
        <option value="">All categories</option>
        <option>Hair & Beauty</option>
        <option>Health & Wellness</option>
        <option>Fitness & Training</option>
        <option>Consulting</option>
        <option>Auto Services</option>
      </select>

      <button
        type="submit"
        class="rounded-lg bg-slate-900 hover:bg-slate-800 text-white font-medium px-5 py-2.5 text-sm transition flex items-center gap-2"
      >
        <span>Search</span>
        <span
          id="search-spinner"
          class="htmx-indicator h-3 w-3 rounded-full border-2 border-white/30 border-t-white animate-spin"
        ></span>
      </button>
    </form>
  </div>

  <!-- Quick category pills -->
  <div class="mt-6 flex flex-wrap gap-2">
    {{#each categories}}
    <button
      hx-get="/businesses/search?category={{this}}"
      hx-target="#business-grid"
      hx-swap="innerHTML"
      class="rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm text-slate-700 hover:border-accent-400 hover:text-accent-700 transition"
    >
      {{this}}
    </button>
    {{/each}}
  </div>

  <!-- Business grid -->
  <div
    id="business-grid"
    class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"
  >
    {{#each businesses}}
    <a
      href="/businesses/{{id}}"
      class="group rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-soft hover:shadow-md hover:-translate-y-0.5 transition"
    >
      <div class="p-5">
        <p class="text-xs font-medium uppercase tracking-wider text-accent-600">
          {{category}}
        </p>
        <h3
          class="mt-1 font-semibold text-slate-900 group-hover:text-accent-700 transition"
        >
          {{name}}
        </h3>
        <p class="mt-1 text-sm text-slate-500 line-clamp-2">{{description}}</p>
        <div class="mt-4 flex items-center justify-between text-sm">
          <span class="flex items-center gap-1 text-slate-700">
            <span class="text-accent-500">★</span> {{rating}}
            <span class="text-slate-400">({{reviewCount}})</span>
          </span>
          <span class="text-slate-500">{{distanceInKM}} km away</span>
        </div>
      </div>
    </a>
    {{/each}}
  </div>
</section>
